        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soubor neobsahuje žádné fotoaparáty."
          }
        }
      }
    },
    "The shutter button takes a picture with the meter settings printed on it." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кнопка спуску робіць здымак з надрукаванымі на ім наладамі экспаномэтра."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spoušť pořídí snímek s vepsaným nastavením expozimetru."
          }
        }
      }
    },
    "This lens has its own leaf shutter, which sets the shutter speed range." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гэты аб’ектыў мае ўласны цэнтральны затвор, які задае межы вытрымкі."
          }
