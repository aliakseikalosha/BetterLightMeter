    },
    "The app uses your iPhone's language if it's supported, otherwise English. To change it, choose Language on the app's page in the Settings app." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Праграма выкарыстоўвае мову вашага iPhone, калі яна падтрымліваецца, інакш — ангельскую. Каб зьмяніць яе, выберыце мову на старонцы праграмы ў Наладах."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace používá jazyk vašeho iPhonu, pokud je podporován, jinak angličtinu. Změníte ho volbou Jazyk na stránce aplikace v Nastavení."
          }
        }
      }
    },
    "The camera didn't return an image." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камэра не вярнула здымак."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera nevrátila snímek."
          }
        }
      }
    },
    "The camera sets the ISO and shutter speed range, the lens sets the aperture range." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фотаапарат задае межы ISO і вытрымкі, аб’ектыў — межы дыяфрагмы."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotoaparát určuje rozsah ISO a časů závěrky, objektiv rozsah clony."
          }
        }
      }
    },
    "The file contains no cameras." : {
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл не зьмяшчае фотаапаратаў."
