    "NSCameraUsageDescription" : {
      "comment" : "Privacy - usage description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Камэра выкарыстоўваецца для замеру сьвятла сцэны."
