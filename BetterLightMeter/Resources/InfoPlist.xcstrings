        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The camera is used to meter the light of the scene."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Месца кожнага зьдымку захоўваецца разам зь ім."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poloha se ukládá s každou pořízenou fotografií."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your location is saved with each picture you take."
          }
        }
      }
    },
