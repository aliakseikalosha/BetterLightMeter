      "comment" : "Privacy - usage description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зробленыя здымкі захоўваюцца з надрукаванымі на іх наладамі экспаномэтра."
